# ============================================================================
# OLICMAT v2.1 — Variáveis de ambiente (PRODUÇÃO)
#
# Copie para `.env` (ou defina no Easypanel) e preencha com valores reais.
#
# Máquina 1 (WEB + Cadastro): docker-compose.prod.yml
# Máquina 2 (Provas):         docker-compose.exam.prod.yml
# Máquina 3 (PostgreSQL):     rede interna 10.42.0.x
#
# ⚠️  JWT_SECRET e DATABASE_URL DEVEM SER IDÊNTICOS nas máquinas 1 e 2.
# ============================================================================

# --- Banco de Dados (PostgreSQL na Máquina 3) ---
DB_USER=olicmat
DB_PASSWORD=GERAR_SENHA_FORTE_AQUI
DB_NAME=olicmat
# Connection string completa apontando para o Postgres da Máquina 3
DATABASE_URL=postgresql://olicmat:GERAR_SENHA_FORTE_AQUI@10.42.0.10:5432/olicmat?schema=public
DB_POOL_SIZE=10

# --- JWT (auth unificada — IDÊNTICO nas máquinas 1 e 2) ---
JWT_SECRET=GERAR_STRING_ALEATORIA_LONGA_AQUI

# --- Cloudinary (upload de arquivos) ---
CLOUDINARY_CLOUD_NAME=SEU_CLOUD_NAME
CLOUDINARY_API_KEY=SUA_API_KEY
CLOUDINARY_API_SECRET=SEU_API_SECRET

# --- Email SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=olicmat@ufpi.edu.br
SMTP_PASS=GERAR_APP_PASSWORD_AQUI
SMTP_FROM=OLICMAT <olicmat@ufpi.edu.br>

# --- URLs públicas (defina os domínios reais) ---
# Máquina 1 — landing pública
NEXT_PUBLIC_API_URL=https://olicmat.cead.ufpi.br/api
NEXT_PUBLIC_SITE_URL=https://olicmat.cead.ufpi.br
NEXT_PUBLIC_ADMIN_URL=https://admin.olicmat.cead.ufpi.br
FRONTEND_URL=https://admin.olicmat.cead.ufpi.br

# Máquina 2 — Módulo Provas (rede interna; exposto via proxy da Máquina 1)
EXAM_APP_URL=https://prova.olicmat.cead.ufpi.br
NEXT_PUBLIC_MAIN_APP_URL=https://admin.olicmat.cead.ufpi.br
