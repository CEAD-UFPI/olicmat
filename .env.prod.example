# ============================================
# OLICMAT — Produção
# ============================================
# Copie para .env e preencha os valores reais.

# --- Banco de Dados ---
DB_USER=olicmat
DB_PASSWORD=GERAR_SENHA_FORTE_AQUI
DB_NAME=olicmat

# --- JWT ---
JWT_SECRET=GERAR_STRING_ALEATORIA_LONGA_AQUI

# --- Cloudinary (upload de arquivos) ---
CLOUDINARY_CLOUD_NAME=SEU_CLOUD_NAME
CLOUDINARY_API_KEY=SUA_API_KEY
CLOUDINARY_API_SECRET=SEU_API_SECRET

# --- Frontend (URL pública da API) ---
# IMPORTANTE: defina o domínio real da sua API
NEXT_PUBLIC_API_URL=https://api.seudominio.com/api
