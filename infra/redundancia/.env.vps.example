# ============================================================================
# OLICMAT — Variáveis de ambiente da VPS (standby)
#
# Copie para `.env.vps` e preencha. Use os MESMOS valores de produção para
# JWT_SECRET, BREVO_API_KEY, SMTP_FROM e as URLs públicas (o DNS é só
# redirecionado para a VPS — os domínios não mudam).
#
# ⚠️ A senha do banco (DB_PASSWORD) pode — e deve — ser NOVA: ela é do cluster
#    local da VPS e NÃO vem no dump. Gere uma URL-safe com:
#        openssl rand -hex 24
# ============================================================================

# --- Banco local da VPS (senha nova, URL-safe) ---
DB_USER=olicmat
DB_PASSWORD=COLE_A_SENHA_NOVA_AQUI__openssl_rand_hex_24
DB_NAME=olicmat

# --- JWT (IDÊNTICO à produção — obrigatório, mín. 32 chars) ---
JWT_SECRET=COLE_O_JWT_SECRET_DE_PRODUCAO_AQUI

# --- URLs públicas (as MESMAS da produção) ---
NEXT_PUBLIC_API_URL=https://olicmat.cead.ufpi.br/api
NEXT_PUBLIC_ADMIN_URL=https://admin.olicmat.cead.ufpi.br
NEXT_PUBLIC_MAIN_APP_URL=https://admin.olicmat.cead.ufpi.br
FRONTEND_URL=https://admin.olicmat.cead.ufpi.br
EXAM_APP_URL=https://prova.olicmat.cead.ufpi.br
PUBLIC_API_URL=https://olicmat.cead.ufpi.br

# --- Email (os MESMOS valores de produção) ---
EMAIL_PROVIDER=brevo
BREVO_API_KEY=COLE_A_BREVO_API_KEY_DE_PRODUCAO_AQUI
SMTP_FROM=OLICMAT <olicmat@ufpi.edu.br>

# --- Publicação ---
# Porta do host onde o router escuta. 8080 por padrão porque o Easypanel ocupa
# a 80/443. Se você desativar o Easypanel, pode trocar para 80.
APP_BIND_IP=0.0.0.0
WEB_HOST_PORT=8080
