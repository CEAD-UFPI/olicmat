# ============================================================================
# OLICMAT v2.1 — Variáveis de ambiente (DESENVOLVIMENTO)
#
# Copie para `.env` e ajuste conforme necessário:
#   cp .env.example .env
#
# O docker-compose.yml constrói o DATABASE_URL a partir de DB_USER/DB_PASSWORD/
# DB_NAME. Para rodar o backend FORA do Docker (npm run start:dev), use a linha
# DATABASE_URL com `localhost:5433`.
# ============================================================================

# --- Banco de Dados (usado pelo docker-compose) ---
DB_USER=olicmat
DB_PASSWORD=olicmat_dev
DB_NAME=olicmat

# --- Conexão direta (fora do Docker) ---
# DATABASE_URL=postgresql://olicmat:olicmat_dev@localhost:5433/olicmat?schema=public
DB_POOL_SIZE=10

# --- JWT (auth unificada — MESMO segredo em admin-api e exam-api) ---
JWT_SECRET=dev_secret_change_in_production

# --- Cloudinary (upload de comprovantes / fase 2) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=olicmat@ufpi.edu.br
SMTP_PASS=
SMTP_FROM=OLICMAT <olicmat@ufpi.edu.br>

# --- URLs dos módulos ---
# Frontend Cadastro/Configurações consome a API (prefixo /api)
NEXT_PUBLIC_API_URL=http://localhost:3333/api
# Landing pública (para onde o "Voltar ao site" do painel redireciona)
NEXT_PUBLIC_SITE_URL=http://localhost:3005
# Landing pública aponta para o painel administrativo
NEXT_PUBLIC_ADMIN_URL=http://localhost:3006
# Onde o Módulo Provas redireciona o aluno após terminar
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3006
# URLs usadas pelo backend para links de e-mail / redirects
FRONTEND_URL=http://localhost:3006
EXAM_APP_URL=http://localhost:3007
